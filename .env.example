# Postgres (production target per docs/DESIGN.md section 4)
DATABASE_URL=postgresql+asyncpg://lineuplab:lineuplab@localhost:5432/lineuplab
DATABASE_URL_READONLY=postgresql+asyncpg://lineuplab_ro:lineuplab_ro@localhost:5432/lineuplab

# Local dev/test fallback when Docker/Postgres is unavailable (see docs/DECISIONS.md)
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

REDIS_URL=redis://localhost:6379/0

# LLM provider: "stub" (default, deterministic, no network/key needed) or "anthropic"
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# "real" (default) or "synthetic" -- see pipeline/data_source.py and
# pipeline/download_real_data.py; "real" needs data_raw/ populated first
# (python -m pipeline.download_real_data). DATA_SOURCE=synthetic is the dev/test
# option (docs/DECISIONS.md "Synthetic data is no longer the silent default").
DATA_SOURCE=real

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

SEED=42
