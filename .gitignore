__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
*.egg-info/

# secrets -- everything except the committed, placeholder-only example
.env
.env.*
!.env.example

# data dumps, raw and processed -- pipeline/download_real_data.py fetches these,
# they're never committed (README documents this)
dev.db
data/
data_raw/

# model artifacts, embedding dumps
*.pt
*.pth
*.onnx
*.safetensors
*.bin
embeddings/
*.index
*.faiss

node_modules/
dist/
.venv/
venv/
*.log
.hypothesis/

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# eval output (generated, not source) -- evals/baselines/ is NOT ignored: CI's
# regression gate (docs/PROGRESS.md Phase 6c Part 4) compares against it, so
# baseline JSONs must be committed.
evals/reports/*.json

# Langfuse / Postgres local bind-mount volumes, if ever used instead of named
# Docker volumes
pgdata/
langfuse-data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
