# Fast, zero-external-dependency deploy image for a shareable public demo link --
# distinct from the repo-root `Dockerfile` (that one targets a real Postgres+Redis
# production setup and is deliberately not run here; see its own header comment).
# This image needs no managed database, no Redis, and no API key: SQLite (the same
# fallback `README.md` documents for local dev) and `LLM_PROVIDER=stub` (no LLM
# key needed -- answers are deterministic, not narrated by a real model). Synthetic
# data only: the real Transfermarkt dataset's host was unreachable from the sandbox
# that built this, and synthetic generation needs no network access either way, so
# it's also the more reliable choice for an unattended cloud build.
# docs/DECISIONS.md "Fast public demo deployment" has the full reasoning.

FROM node:20-slim AS frontend-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM python:3.12-slim AS base
WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

COPY config ./config
COPY db ./db
COPY engine ./engine
COPY pipeline ./pipeline
COPY rag ./rag
COPY llm ./llm
COPY graph ./graph
COPY api ./api

COPY --from=frontend-build /app/frontend/dist ./frontend/dist

ENV PYTHONUNBUFFERED=1
ENV DATA_SOURCE=synthetic
ENV LLM_PROVIDER=stub

# Seeds ./dev.db (SQLite) at build time, baked into the image -- deterministic
# (config.settings.seed), no network access needed, and means container start is
# instant instead of re-seeding on every boot. Also downloads the embedding/
# reranker models (BAAI/bge-small-en-v1.5, BAAI/bge-reranker-base) into the image's
# HF cache, same reason: pay that cost once at build time, not on first request.
RUN python -m pipeline.run_all

EXPOSE 8000
ENV PORT=8000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
